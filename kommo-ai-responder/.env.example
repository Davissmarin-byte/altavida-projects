# Puerto donde escucha el servicio
PORT=3000

# Secreto compartido que Salesbot debe enviar en el header X-Webhook-Secret
# Genera uno propio, ej: openssl rand -hex 32
KOMMO_WEBHOOK_SECRET=

# API key de Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Modelo de Claude a usar
AI_MODEL=claude-sonnet-5

# Prompt de sistema que define cómo responde el asistente.
# Si se deja vacío se usa el prompt por defecto en src/ai.ts
AI_SYSTEM_PROMPT=
